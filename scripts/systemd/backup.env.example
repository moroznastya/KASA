# ============================================================================
# backup.env.example — облікові дані для systemd-бекапів
# ============================================================================
# Скопіюйте в /etc/torgashka/backup.env (chmod 600) і заповніть.
# Використовується unit-файлами torgashka-backup.service та
# torgashka-meta-backup.service (EnvironmentFile).
#
# ⚠️  Цей файл містить паролі — НЕ комітити в git! (зразок — без секретів)
# ============================================================================

# --- Спосіб 1: компоненти (PGHOST/PGPORT/PGUSER/PGPASSWORD) -----------------
# Host/порт PostgreSQL. Для Docker: host=localhost, port=проброшений порт
# (docker-compose: db → "5434:5432", db-test → "5433:5432").
PGHOST=localhost
PGPORT=5434
PGUSER=postgres
# 🔐 Пароль суперкористувача (той самий, що DB_PASSWORD у .env / docker-compose)
PGPASSWORD=

# --- Спосіб 2 (альтернатива): повний DSN — перекриває PGHOST* ---------------
# DATABASE_URL=postgresql://postgres:ПАРОЛЬ@localhost:5434/pos_system

# --- Імена/каталоги (опційно, дефолти вказано) ------------------------------
# META_DB=pos_system
# BACKUP_DIR=/opt/torgashka/backups
# LOG_DIR=/opt/torgashka/logs
# KEEP_DAYS=14
# JOBS=4
# BACKUP_INCLUDE_TEMPLATE=0
# --- Локальна SQLite-черга каси (Фаза 3.9; повний цикл бекапить її завжди) ----
# OFFLINE_DB=/home/kasa/.local/share/torgashka/offline.db   # дефолт: ${XDG_DATA_HOME:-$HOME/.local/share}/torgashka/offline.db
# BACKUP_QUEUE=1        # 0 = не бекапити чергу (те саме, що --no-queue)
# ⚠️  На касі мусить бути встановлений sqlite3: без нього бекап черги завершується
#     помилкою (неконсистентний cp заборонено), а не тихим пропуском.
