# ============================================================================
# torgashka-meta-backup.timer — бекап мета-БД двічі на добу: 02:00 і 14:00
# ============================================================================
# ЕТАП 14: мета-БД pos_system — критична (owners_db → маршрутизація).
# Частота вища, ніж у повного бекапу: 02:00 (після/разом з повним) + 14:00.
# ============================================================================

[Unit]
Description=Torgashka POS — бекап мета-БД pos_system (02:00, 14:00)
Documentation=docs/infrastructure/backup-restore.md

[Timer]
# Двічі на добу: 02:00 і 14:00
OnCalendar=*-*-* 02:00:00
OnCalendar=*-*-* 14:00:00
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
