# ============================================================================
# Torgashka POS — config.toml (роль додатка для PostgreSQL, ЕТАП 7.3)
# ============================================================================
# Призначення: Rust-фасад (torgashka-api) працює з PostgreSQL під ОКРЕМОЮ
# роллю `torgashka_app` (НЕ власник таблиць → RLS застосовується завжди).
#
# Як увімкнути:
#   1) Створіть роль + гранти: APP_DB_PASSWORD='<пароль>' \
#        psql -h <host> -U postgres -d postgres -f scripts/create_app_role.sql
#      (або дозвольте setup-сервісу створити роль автоматично — див. нижче).
#   2) Скопіюйте цей файл у config.toml і заповніть app_db_password.
#   3) chmod 600 config.toml (пароль у файлі!).
#
# Шляхи пошуку config.toml (перший знайдений виграє):
#   - env TORGASHKA_CONFIG=<абсолютний шлях>
#   - ./config.toml (CWD)
#   - frontend/src-tauri/config.toml
#   - <репозиторій>/config.toml
# Env-перевизначення (вищий пріоритет): APP_DB_USER, APP_DB_PASSWORD.
#
# ⚠️ stability_first: якщо app_db_password НЕ задано — підміна ролі НЕ
#    виконується, фасад працює під користувачем DSN (backend/.env DB_USER),
#    як раніше. Локальні dev/тести можуть лишитись під postgres.
#
# ⚠️ Не зберігайте цей файл як `config.toml` з реальним паролем у git!
#    (config.toml додано в .gitignore.)
# ============================================================================

[database]
# Роль для ВСІХ бізнес-підключень (RLS: не власник таблиць).
# Тести/CI можуть перевизначити на "postgres" через APP_DB_USER.
app_db_user = "torgashka_app"

# 🔐 Пароль ролі. Обов'язковий для увімкнення підміни ролі.
# Якщо порожній/відсутній — фасад працює під DSN-користувачем (legacy).
app_db_password = ""

# ─── Пул пулів (ЕТАП 9.1: маршрутизація до персональних БД власників) ────
# ⚠️ Маршрутизація ВИМКНЕНА за замовчуванням (stability_first): персональні
# БД власників (torgashka_owner_*) наразі є СХЕМНИМИ клонами без даних —
# механізм міграції даних з мета-БД ще не реалізовано. Увімкнення до цього
# зламало б запити власників, що мають персональну БД.
# Увімкніть (true) ЛИШЕ після появи наповнення owner-БД даними.
# Env: APP_OWNER_ROUTING / TORGASHKA_OWNER_ROUTING (1|true|0|false).
owner_routing = false

# Кількість одночасно відкритих пулів до БД власників (LRU-витіснення
# найстаріших; дефолт 16). Env: APP_POOL_CACHE_SIZE.
pool_cache_size = 16

# Час очікування з'єднання з пулу, секунди (дефолт 5 — LAN-розгортання:
# швидкий відказ, а не зависання). Env: APP_ACQUIRE_TIMEOUT.
acquire_timeout = 5

# TTL кешу резолву owner_id → db_name, секунди (дефолт 60 — мета-БД не
# б'ється на кожен запит; зміна БД власника помічається протягом хвилини).
# Env: APP_RESOLVE_TTL.
resolve_ttl = 60

# ─── Примітка: setup-сервіс (перший власник) ───────────────────────────────
# При першому setup на fresh-кластері роль torgashka_app створюється
# АВТОМАТИЧНО (CREATE ROLE ... NOSUPERUSER NOBYPASSRLS NOCREATEDB
# NOCREATEROLE) з паролем app_db_password, і на неї призначаються гранти
# (мета-БД + шаблон + owner-БД). Окремий ручний запуск create_app_role.sql
# потрібен лише якщо роль має існувати ДО першого setup.

# ============================================================================
# [server] — режим запуску (ЕТАП 0 «Мережева доступність сервера», sync-offline)
# ============================================================================
# Можливі значення mode:
#   "desktop" — Tauri-застосунок на машині магазину (ЛОКАЛЬНИЙ фасад,
#               слухає 127.0.0.1:8000);
#   "server"  — виділений сервер мережі магазинів (VPS+VPN, фасад слухає
#               VPN-IP:8000, до нього підключаються каси магазинів).
#
# ⚠️ ПРІОРИТЕТ: env TORGASHKA_FACADE_ADDR МАЄ ПРІОРИТЕТ над addr з цієї секції
#    (bin/facade.rs: std::env::var("TORGASHKA_FACADE_ADDR")
#    .unwrap_or(DEFAULT_FACADE_ADDR="127.0.0.1:8000")).
#    Тобто:
#      - задали TORGASHKA_FACADE_ADDR=<vpn-ip>:8000 у systemd/env → server-режим;
#      - НЕ задали → фасад слухає 127.0.0.1:8000 (desktop/dev за замовчуванням).
#    Ця секція — декларативний опис режиму; фактична адреса береться з env.
#    На сервері задавайте через /etc/torgashka/facade.env (див.
#    deploy/network/torgashka-facade.service та deploy/network/README.md).
#
# [server]
# mode = "desktop"   # або "server"
# addr = "127.0.0.1:8000"   # інформаційно: env TORGASHKA_FACADE_ADDR виграє
