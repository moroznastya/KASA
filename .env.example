# ============================================================================
# Torgashka — Environment Variables (для docker-compose)
# ============================================================================
# Скопіюйте в .env та налаштуйте під своє середовище:
#   cp .env.example .env
#
# 🔐 ВАЖЛИВО (безпека):
#   - Значення секретів НЕ повинні бути зашиті в коді/git
#   - Всі паролі задаються ТІЛЬКИ в цьому файлі (він у .gitignore)
#   - Не використовуйте старі скомпрометовані значення!
# ============================================================================

# --- PostgreSQL (обов'язково!) ---
# 🔐 Задайте надійний пароль для основної БД.
#    docker-compose вимагає цю змінну: ${DB_PASSWORD:?DB_PASSWORD is required}
DB_PASSWORD=

# --- PostgreSQL тестова БД (для CI) ---
# Якщо не задано — використовується дефолт test_password
DB_TEST_PASSWORD=

# --- Безпека застосунку (обов'язково!) ---
# 🔐 Згенеруйте новий ключ: openssl rand -hex 32
SECRET_KEY=

# ============================================================================
# Tauri Updater — ключі підпису артефактів оновлення
# ============================================================================
# ⚠️ ЦІ ЗМІННІ ВИКОРИСТОВУЮТЬСЯ ТІЛЬКИ ДЛЯ `tauri build` (створення release).
#    Вони НЕ потрібні для `tauri dev` / роботи застосунку.
#
# 🔑 Згенеруйте ключову пару (ОДИН раз):
#   cd frontend && npx tauri signer generate --ci -p "ВАШ_ПАРОЛЬ" \
#     -w src-tauri/.tauri/kasa-pos.key
#   → приватний ключ:  src-tauri/.tauri/kasa-pos.key       (НЕ КОМІТИТИ!)
#   → публічний ключ:  src-tauri/.tauri/kasa-pos.key.pub  (значення → tauri.conf.json → plugins.updater.pubkey)
#
# Локально зручно покласти ці змінні у frontend/src-tauri/.env (у .gitignore).
# У CI/GitHub Actions передавайте їх через Secrets репозиторію.
#
# Шлях до файлу приватного ключа (або сам ключ у TAURI_SIGNING_PRIVATE_KEY):
TAURI_SIGNING_PRIVATE_KEY_PATH=
# Пароль приватного ключа (той самий, що вказано при генерації):
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
