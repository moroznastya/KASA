# Шаблон конфігурації для діагностичних скриптів Torgashka.
#
# Скопіюйте у artifacts/.env.local і заповніть реальними значеннями:
#     cp artifacts/.env.local.example artifacts/.env.local
#     chmod 600 artifacts/.env.local
#
# artifacts/.env.local у .gitignore — у репо не потрапляє.
# Скрипти читають ці змінні через artifacts/scripts/_lib.sh (bash)
# та artifacts/scripts/_env.py (python).

# ── Хаб (головний вузол мережі) ──────────────────────────────
HUB_HOST=<hub-host>
HUB_PG_USER=postgres
HUB_PG_DB=pos_system
HUB_PG_PASSWORD=<hub-pg-password>

# ── Локальна каса (API + SQLite-дзеркало) ────────────────────
TORGASHKA_API_BASE=http://127.0.0.1:8000
TORGASHKA_OFFLINE_DB=$HOME/.local/share/torgashka/offline.db
