# =============================================================================
# .dockerignore — Torgashka Backend
# =============================================================================
# 🔐 БЕЗПЕКА: .env НЕ потрапляє в Docker-образ!
#    Секрети передаються через environment у docker-compose.yml.
# =============================================================================

# ─── Секрети та конфіги ──────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Віртуальні середовища ──────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
venv.bak/
venv/

# ─── Тести та інструменти якості ────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
nox/
.cache/

# ─── IDE та ОС ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Git ─────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ─── Документація та допоміжне ──────────────────────────────────────────────
docs/
*.md
!README.md
