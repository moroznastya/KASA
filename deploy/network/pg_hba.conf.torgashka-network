# ============================================================================
# pg_hba.conf.torgashka-network — зразок автентифікації для сервера мережі
# магазинів (ЕТАП 0 «Мережева доступність сервера», гілка sync-offline)
# ============================================================================
# ⚠️ Це ЗРАЗОК (не готовий файл!). Порядок правил у pg_hba МАЄ ЗНАЧЕННЯ:
#    PostgreSQL перевіряє правила ЗВЕРХУ ВНИЗ і зупиняється на ПЕРШОМУ
#    збігу (тип + БД + користувач + адреса). Тому:
#      1) локальні/специфічні правила — ВИЩЕ,
#      2) широкі/обмежувальні (reject) — НИЖЧЕ.
#
# Як застосувати:
#   sudo cp deploy/network/pg_hba.conf.torgashka-network \
#       /etc/postgresql/16/main/pg_hba.conf
#   sudo chown postgres:postgres /etc/postgresql/16/main/pg_hba.conf
#   sudo chmod 640 /etc/postgresql/16/main/pg_hba.conf
#   sudo systemctl reload postgresql        # reload БЕЗ розриву з'єднань
#   sudo -u postgres psql -c "SELECT 1;"    # перевірка, що local працює
# ============================================================================

# ---------------------------------------------------------------------------
# 1) ЛОКАЛЬНИЙ Unix-socket доступ — ЛИШЕ для OS-користувача postgres.
#    Це єдине правило з методом trust: воно діє тільки на самій машині
#    сервера і тільки для системного користувача postgres (sudo -u postgres).
# ---------------------------------------------------------------------------
local   all             postgres                                trust

# Резервний варіант (замість trust) — якщо хочете пароль і для локального
# postgres-юзера. trust лишили, бо типова Debian-установка PG16 і так
# покладається на peer для postgres; але для канонічної безпеки краще:
# local   all             postgres                                peer
# (peer = OS-користувач postgres має збігатися з роллю БД — найбезпечніше).

# ---------------------------------------------------------------------------
# 2) Локальні Unix-socket з'єднання для інших ролей (наприклад бекенд на
#    тій самій машині, що ходить через socket) — ЛИШЕ з паролем scram.
#    Якщо весь локальний доступ іде через TCP 127.0.0.1 — цей рядок можна
#    прибрати; якщо лишили — він нижче за postgres, тому postgres-safe.
# ---------------------------------------------------------------------------
local   all             all                                     scram-sha-256

# ---------------------------------------------------------------------------
# 3) ЛОКАЛЬНИЙ TCP (loopback) — 127.0.0.1/::1. Дозволено з паролем.
#    Тут сидить Rust-фасад torgashka-api та Python-бекенд (якщо ще живий),
#    коли вони на тій самій машині, що PostgreSQL.
# ---------------------------------------------------------------------------
host    all             all             127.0.0.1/32            scram-sha-256
host    all             all             ::1/128                 scram-sha-256

# ---------------------------------------------------------------------------
# 4) ВІДДАЛЕНІ КЛІЄНТИ — ЛИШЕ ЧЕРЕЗ VPN І ЛИШЕ З SSL (hostssl).
#    ⚠️ НЕ додавайте рядок 'host' (без ssl) для віддалених підмереж:
#       це дозволить передачу паролів відкритим текстом.
#
#    Tailscale використовує CGNAT-підмережу 100.64.0.0/10 (100.64.0.0 —
#    100.127.255.255). Це найпоширеніший варіант — рядок нижче активний.
#    Якщо у вас ZeroTier — підмережа зазвичай 10.147.17.0/24 або 100.x.y.0/24
#    (див. коментарі під активним рядком) — розкоментуйте відповідний.
# ---------------------------------------------------------------------------
hostssl all             all             100.64.0.0/10           scram-sha-256

# ZeroTier (приклад для типових діапазонів — розкоментуйте СВІЙ):
# hostssl all             all             10.147.17.0/24          scram-sha-256
# hostssl all             all             100.100.0.0/24          scram-sha-256

# ---------------------------------------------------------------------------
# 5) УСЕ ІНШЕ — ВІДМОВИТИ (явний кінець правил).
#    Цей блок гарантує: будь-яке джерело поза локальним/VPN не зможе
#    підключитися, навіть якщо firewall випадково відкриє порт.
#    Правила reject мають бути ОСТАННІМИ (перевірка зверху вниз).
# ---------------------------------------------------------------------------
host    all             all             0.0.0.0/0               reject
host    all             all             ::0/0                   reject

# ============================================================================
# ⚠️ НЕ додавайте сюди правила для публічних IP (0.0.0.0/0 з методом md5/
#    scram) — сервер мережі магазинів НЕ доступний з інтернету напряму.
#
# Перевірка після застосування:
#   sudo -u postgres psql -c "SELECT type, database, user_name, address,
#       auth_method FROM pg_hba_file_rules ORDER BY line_number;"
#   sudo systemctl reload postgresql
# З ТОЧКИ магазину (у VPN): psql "host=<vpn-ip> port=5432 dbname=pos_system
#   user=torgashka_app sslmode=require"  →  має запитати пароль і пустити.
# ============================================================================
